{
  "id": "claude",
  "label": "Claude Code",
  "name": "Claude Code",
  "command": "claude",
  "args": [
    "-p",
    "{prompt}",
    "--restricted",
    "--safe-mode",
    "--strict-mcp-config",
    "--permission-mode",
    "acceptEdits",
    "--permission-prompts",
    "none",
    "--tools",
    "Read,Write,Edit,Glob,WebSearch,WebFetch",
    "--allowedTools",
    "WebSearch",
    "WebFetch",
    "--disallowedTools",
    "WebFetch(domain:127.*.*.*)",
    "WebFetch(domain:localhost)",
    "WebFetch(domain:*.localhost)",
    "WebFetch(domain:0.0.0.0)",
    "WebFetch(domain:[::1])",
    "WebFetch(domain:10.*.*.*)",
    "WebFetch(domain:192.168.*.*)",
    "WebFetch(domain:169.254.*.*)",
    "WebFetch(domain:172.16.*.*)",
    "WebFetch(domain:172.17.*.*)",
    "WebFetch(domain:172.18.*.*)",
    "WebFetch(domain:172.19.*.*)",
    "WebFetch(domain:172.20.*.*)",
    "WebFetch(domain:172.21.*.*)",
    "WebFetch(domain:172.22.*.*)",
    "WebFetch(domain:172.23.*.*)",
    "WebFetch(domain:172.24.*.*)",
    "WebFetch(domain:172.25.*.*)",
    "WebFetch(domain:172.26.*.*)",
    "WebFetch(domain:172.27.*.*)",
    "WebFetch(domain:172.28.*.*)",
    "WebFetch(domain:172.29.*.*)",
    "WebFetch(domain:172.30.*.*)",
    "WebFetch(domain:172.31.*.*)",
    "--model",
    "sonnet",
    "--no-session-persistence",
    "--output-format",
    "json",
    "--max-budget-usd",
    "2"
  ],
  "prompt": "請先讀呢個資料夾入面嘅 task.md，然後完全照入面嘅指示做；所有產出只可以寫入 out 資料夾。",
  "timeoutMinutes": 15,
  "versionArgs": [
    "--version"
  ],
  "required": {
    "mustHave": [
      "--restricted",
      "--strict-mcp-config",
      "--permission-prompts",
      "none"
    ],
    "toolsFlag": "--tools",
    "toolsAllowed": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "mustNotHave": [
      "--dangerously-skip-permissions",
      "bypassPermissions",
      "--add-dir"
    ],
    "webTools": [
      "WebSearch",
      "WebFetch"
    ],
    "mustDeny": [
      "127.*.*.*",
      "localhost",
      "10.*.*.*",
      "192.168.*.*",
      "169.254.*.*",
      "172.16.*.*",
      "172.17.*.*",
      "172.18.*.*",
      "172.19.*.*",
      "172.20.*.*",
      "172.21.*.*",
      "172.22.*.*",
      "172.23.*.*",
      "172.24.*.*",
      "172.25.*.*",
      "172.26.*.*",
      "172.27.*.*",
      "172.28.*.*",
      "172.29.*.*",
      "172.30.*.*",
      "172.31.*.*"
    ],
    "note": "網絡：所有 AI 工作都可以對外讀取（搜尋、讀網頁、下載公開資料），一定要禁止本機同私人網段（規劃書 5.2 第 3、4 點、決定十六）"
  },
  "chat": {
    "note": "情景演練扮對方（原型試行）：冇工具、唔讀設定、清走 MCP；伺服器開，等創辦人決定正式規則",
    "args": [
      "-p",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--include-partial-messages",
      "--restricted",
      "--safe-mode",
      "--strict-mcp-config",
      "--tools",
      "",
      "--model",
      "{model}",
      "--no-session-persistence",
      "--system-prompt-file",
      "{system}",
      "--max-budget-usd",
      "1"
    ],
    "fastModel": "haiku",
    "reviewModel": "sonnet"
  },
  "roles": {
    "note": "紅藍對打角色模型表（原型）：同一服務商三個不同模型；只換 --model，限制同工具唔變；裁判唔可以同藍方同一模型。轉強由藍方模型做。",
    "blue": "sonnet",
    "red": "haiku",
    "judge": "opus",
    "timeoutMinutes": 25
  }
}

{
  "id": "codex",
  "label": "Codex",
  "name": "Codex",
  "command": "codex",
  "args": [
    "exec",
    "--ignore-user-config",
    "-c",
    "windows.sandbox=\"unelevated\"",
    "-C",
    "{cwd}",
    "-s",
    "workspace-write",
    "-c",
    "approval_policy=\"never\"",
    "-c",
    "web_search=\"disabled\"",
    "-c",
    "project_doc_max_bytes=0",
    "--disable",
    "apps",
    "--disable",
    "browser_use",
    "--disable",
    "browser_use_external",
    "--disable",
    "computer_use",
    "--disable",
    "plugins",
    "--disable",
    "remote_plugin",
    "--disable",
    "image_generation",
    "--disable",
    "multi_agent",
    "--disable",
    "goals",
    "--disable",
    "memories",
    "--disable",
    "hooks",
    "--disable",
    "in_app_browser",
    "--model",
    "gpt-6.1-terra",
    "-c",
    "model_reasoning_effort=\"medium\"",
    "--skip-git-repo-check",
    "--ephemeral",
    "-o",
    "{outfile}",
    "{prompt}"
  ],
  "prompt": "請先讀呢個資料夾入面嘅 task.md，然後完全照入面嘅指示做；所有產出只可以寫入 out 資料夾。",
  "timeoutMinutes": 10,
  "versionArgs": [
    "--version"
  ],
  "outputFile": "last-message.txt",
  "required": {
    "mustHave": [
      "-s",
      "workspace-write",
      "approval_policy=\"never\"",
      "web_search=\"disabled\"",
      "--ignore-user-config"
    ]
  }
}
